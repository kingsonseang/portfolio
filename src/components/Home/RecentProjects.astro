---
import { projects } from "@/data/projects";
import { ProjectCard } from "@/components/ProjectCard";

const minimal = true;
---

<section class="px-6 pb-16 md:px-8 lg:px-10 xl:px-12">
  <div class="mb-10 flex items-end justify-between">
    <div>
      <p class="text-secondary/40 mb-1 text-xs font-medium tracking-widest uppercase">
        Selected work
      </p>
      <h2 class="text-secondary text-2xl font-semibold md:text-3xl">Recent Projects</h2>
    </div>
    <a
      href="/projects"
      class="text-secondary/50 hover:text-secondary group flex items-center gap-1.5 text-sm transition-colors duration-200"
    >
      View all
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-200 group-hover:translate-x-1"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects
        .filter((project) => project.featured)
        .sort((a, b) => Number(b.year) - Number(a.year))
        .map((project) => <ProjectCard project={project} minimal={minimal} />)
    }
  </div>
</section>
