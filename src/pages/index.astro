---
 import '../styles/global.css'
 import Github from '../components/icons/github.astro'
 import XLogo from '../components/icons/x-logo.astro'
 import LinkedIn from '../components/icons/linkedin.astro'
 import { Image } from 'astro:assets';
 import bannerImage from '../assets/banner-hand-drawn.jpeg'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <!-- iOS / Apple Support -->
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <!-- Android / Web App Manifest -->
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#ffffff" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Solomon Momoh</title>
	</head>
	<body class="antialiased">
		<main class="max-w-3xl mx-auto p-4 prose">
		    <div>
				<Image src={bannerImage} alt="banner" class="w-full" />
			</div>
    		<div>
    			<h1>Hi, I'm Solomon.</h1>
    			<p>I'm a software engineer who build stuff. currently exploring AI engineering as my next career path, I currently specialize in building full stack web applications.</p>
    		</div>
            <div></div>
            <div>
                <div>
                    <h2>Work</h2>
                    <p>I currently work at <a href="https://sparkmarkets.co">Spark Africa</a> an Infrastructure & Full Stack Engineer, before that I worked at <a href="https://usestraqa.com">Straqa</a> as a full stack engineer and later Lead frontend engineer and a couple of other places as well as a bit of freelance work</p>
                </div>
                <div>
                    <a href="/cv">Read my cv</a>
                </div>
            </div>
    		<div>
       			<div>
                    <h2>#lets connect</h2>
                    <p>If you're hiring, or just want to chat you could reach out to me on any of these platforms!</p>
                </div>
                <div>
                    {[
                        { content: 'solomon-momoh', icon: LinkedIn, title: 'LinkedIn Profile', url: 'https://www.linkedin.com/in/solomon-momoh' },
                        { content: '@kingsonseang', icon: Github, title: 'GitHub Profile', url: 'https://github.com/kingsonseang' },
                        { content: '@kingsonseang', icon: XLogo, title: 'X Profile', url: 'https://twitter.com/kingsonseang' },
                    ].map((item) => (
                        <a href={item.url} title={item.title} class="flex items-center gap-1.5"><item.icon class="size-4" /><span>{item.content}</span></a>
                    ))}
                </div>
    		</div>
		</main>
	</body>
</html>
