{
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "CSS": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["prettier", "--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "Astro": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": [
            "prettier",
            "--plugin",
            "prettier-plugin-astro",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
      "format_on_save": "on",
    },
  },
}
